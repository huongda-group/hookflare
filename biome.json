{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.wrangler",
			"!**/.superpowers",
			"!**/dist",
			"!**/worker-configuration.d.ts",
			"!pnpm-lock.yaml"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["apps/gateway/src/ingress/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/admin", "**/admin/**"],
										"message": "ingress/ must not import from admin/ (it will become its own Worker)."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
