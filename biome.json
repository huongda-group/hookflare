{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.wrangler",
			"!**/.superpowers",
			"!**/dist",
			"!**/worker-configuration.d.ts",
			"!pnpm-lock.yaml"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	}
}
