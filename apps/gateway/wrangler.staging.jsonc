{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "hookflare-staging",
	"main": "src/index.ts",
	// The dashboard SPA (spec §8). Only these paths run the Worker first; every
	// other path is a static file, or index.html for client-side routes.
	"assets": {
		"directory": "../dashboard/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/in/*", "/healthz"]
	},
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"enabled": true
	},
	"vars": {
		// Staging Access application (not secrets). Set per deployment;
		// the admin API fails closed (500) while they are empty.
		// debug | info | warn | error
		"LOG_LEVEL": "info",
		// Cloudflare Access for /api/admin/v1 (not secrets). Set per deployment;
		// the admin API fails closed (500) while they are empty.
		"ACCESS_TEAM_DOMAIN": "",
		// set at setup
		"ACCESS_AUD": "",
		// Comma-separated emails allowed to use the admin API until RBAC (M3).
		"BOOTSTRAP_ADMIN_EMAILS": "",
		// Origin used for ingress_url in admin responses, e.g. https://hooks.example.com.
		// Empty means the origin of the admin request.
		"PUBLIC_BASE_URL": ""
	},
	"queues": {
		"producers": [
			{ "binding": "QUEUE", "queue": "hookflare-deliveries-staging" }
		],
		"consumers": [
			{
				"queue": "hookflare-deliveries-staging",
				"max_batch_size": 10,
				// Only consecutive infra failures count here (retries are new
				// messages, spec M2-1); 20 spans ~15 h before the DLQ.
				"max_retries": 20,
				"dead_letter_queue": "hookflare-deliveries-dlq-staging"
			},
			{
				"queue": "hookflare-deliveries-dlq-staging",
				"max_batch_size": 10,
				"max_retries": 100
			}
		]
	},
	"r2_buckets": [
		{ "binding": "PAYLOADS", "bucket_name": "hookflare-payloads-staging" }
	],
	"triggers": { "crons": ["* * * * *", "*/5 * * * *", "0 3 * * *"] },
	"ratelimits": [
		{
			"name": "INGRESS_LIMITER",
			// Any account-unique integer; no resource needs to be created.
			"namespace_id": "1001",
			"simple": { "limit": 100, "period": 10 }
		}
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hookflare-staging",
			// Staging D1 database. Replaced with the real ID by Task 6
			// (`wrangler d1 create hookflare-staging`). Local dev and tests
			// use local D1 and never contact it.
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	// M5a: one limiter per destination (spec §5.2).
	"durable_objects": {
		"bindings": [{ "name": "LIMITER", "class_name": "DestinationLimiter" }]
	},
	// M5c: archive & retention (spec §7.4).
	"workflows": [
		{
			"name": "hookflare-archive-staging",
			"binding": "ARCHIVE",
			"class_name": "ArchiveWorkflow"
		}
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DestinationLimiter"] }]
}
