# Local dev secrets. Copy to `.dev.vars` (git-ignored) and fill in real values.
# Never commit real secrets.
# Generate a key with: openssl rand -base64 32
SECRETS_KEY="REPLACE_ME"
# Local only: skips Access JWT checks for requests to localhost/127.0.0.1 and
# acts as this email (it must also be in BOOTSTRAP_ADMIN_EMAILS).
ACCESS_DEV_EMAIL="you@example.com"
BOOTSTRAP_ADMIN_EMAILS="you@example.com"
