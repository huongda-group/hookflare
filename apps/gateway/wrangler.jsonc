{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "hookflare",
	"main": "src/index.ts",
	// The dashboard SPA (spec §8). Only these paths run the Worker first; every
	// other path is a static file, or index.html for client-side routes.
	"assets": {
		"directory": "../dashboard/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/in/*", "/healthz"]
	},
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"enabled": true
	},
	"vars": {
		// debug | info | warn | error
		"LOG_LEVEL": "info",
		// Cloudflare Turnstile site key for the login and setup forms (public,
		// not a secret). Empty disables Turnstile; the secret is set separately
		// as TURNSTILE_SECRET_KEY, and both must be set or neither (spec §6.5.1).
		"TURNSTILE_SITE_KEY": "",
		// Origin used for ingress_url in admin responses, e.g. https://hooks.example.com.
		// Empty means the origin of the admin request.
		"PUBLIC_BASE_URL": ""
	},
	"queues": {
		"producers": [{ "binding": "QUEUE", "queue": "hookflare-deliveries" }],
		"consumers": [
			{
				"queue": "hookflare-deliveries",
				"max_batch_size": 10,
				// Only consecutive infra failures count here (retries are new
				// messages, spec M2-1); 20 spans ~15 h before the DLQ.
				"max_retries": 20,
				"dead_letter_queue": "hookflare-deliveries-dlq"
			},
			{
				"queue": "hookflare-deliveries-dlq",
				"max_batch_size": 10,
				"max_retries": 100
			}
		]
	},
	"r2_buckets": [
		{ "binding": "PAYLOADS", "bucket_name": "hookflare-payloads" },
		{ "binding": "BACKUPS", "bucket_name": "hookflare-backups" }
	],
	"triggers": {
		"crons": ["* * * * *", "*/5 * * * *", "0 3 * * *", "0 20 * * *"]
	},
	"ratelimits": [
		{
			"name": "INGRESS_LIMITER",
			// Any account-unique integer; no resource needs to be created.
			"namespace_id": "1001",
			"simple": { "limit": 100, "period": 10 }
		},
		{
			"name": "LOGIN_LIMITER",
			// Per-IP login/setup attempts (spec §6.5): 10 per minute. Distinct
			// namespace from INGRESS_LIMITER; no resource needs to be created.
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hookflare",
			// Production D1 database. A fork or separate deployment must replace this
			// with its own ID from `wrangler d1 create hookflare`. Local dev and tests
			// use local D1 and never contact it.
			"database_id": "29d2c40d-c643-4a67-bba1-ccd2e5c04bc1"
		}
	],
	// M5a: one limiter per destination (spec §5.2).
	"durable_objects": {
		"bindings": [{ "name": "LIMITER", "class_name": "DestinationLimiter" }]
	},
	// M5c: archive & retention (spec §7.4).
	"workflows": [
		{
			"name": "hookflare-archive",
			"binding": "ARCHIVE",
			"class_name": "ArchiveWorkflow"
		},
		{
			"name": "hookflare-backup",
			"binding": "BACKUP",
			"class_name": "BackupWorkflow"
		}
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DestinationLimiter"] }]
}
